# Free, offline mode is the default. Set to false only after configuring X auth.
MOCK_X=true

# Optional standalone Mock X server. Leave blank for the embedded mock profiles.
# Start it with: python -m mock_x_platform
MOCK_X_BASE_URL=
MOCK_X_HOST=127.0.0.1
MOCK_X_PORT=8765
MOCK_X_DATABASE_PATH=.cache/mock_x_platform.sqlite3

# Required for live mode: OAuth user-context bearer access token (not app-only).
X_ACCESS_TOKEN=

# Kept here for your OAuth 2.0 PKCE app setup/token helper, if you use one.
X_CLIENT_ID=
X_CLIENT_SECRET=

# Optional settings
CACHE_PATH=.cache/x_user_search.json
X_REQUEST_TIMEOUT=15

# Offline voice input. Download the model once with:
# python -m voice.download_model
VOICE_MODEL=base.en
VOICE_MODEL_PATH=.models/faster-whisper/base.en
VOICE_RECORD_SECONDS=8
VOICE_SAMPLE_RATE=16000
VOICE_INPUT_DEVICE=
VOICE_LANGUAGE=en
VOICE_COMPUTE_DEVICE=cpu
VOICE_COMPUTE_TYPE=int8
VOICE_CPU_THREADS=0
VOICE_NUM_WORKERS=1

# Device UI: windowed on Windows, fullscreen on Raspberry Pi.
DEVICE_FULLSCREEN=false
DEVICE_FPS=30

MOCK_X=true
MOCK_X_BASE_URL=http://127.0.0.1:8765